{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/wallet", "destination": "https://wallet.r1do.com/wallet" },
    { "source": "/wallet/:path*", "destination": "https://wallet.r1do.com/wallet/:path*" }
  ]
}
